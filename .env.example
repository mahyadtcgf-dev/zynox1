# --- Zynox environment configuration ---
# Copy to .env and fill in real values. Never commit real secrets.

# ── Application ──────────────────────────────────────────────
APP_NAME=Zynox
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
# Required. Railway: ${Postgres.DATABASE_URL}
# Local dev default below matches docker-compose.yml. Change the password
# locally or rely on DATABASE_URL from your platform - never commit real values.
DATABASE_URL=postgresql://zynox:change-me@localhost:5432/zynox

# ── Secrets ──────────────────────────────────────────────────
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret
SESSION_SECRET=change-me-session-secret

# ── Initial administrator ────────────────────────────────────
# Required in production. No default password exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Tokens ───────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Network / security ───────────────────────────────────────
# Comma-separated. Empty = same-origin only.
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true

# ── Telegram ─────────────────────────────────────────────────
# From @BotFather. Never hardcode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=
TELEGRAM_WEBAPP_AUTH_TIMEOUT_SECONDS=300

# ── Xray ─────────────────────────────────────────────────────
XRAY_BINARY_PATH=/usr/local/bin/xray
XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_API_ADDRESS=127.0.0.1:10085
XRAY_API_TIMEOUT_SECONDS=5
# local | api  (how the adapter talks to xray-core)
XRAY_CONTROL_MODE=local
